<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BatteryPerformanceManager</AssemblyName>
    <RootNamespace>BatteryPerformanceManager.TrayApp</RootNamespace>

    <!-- Shown in Task Manager and in the executable's Properties > Details. -->
    <Product>Battery and Performance Manager</Product>
    <AssemblyTitle>Battery and Performance Manager</AssemblyTitle>
    <Authors>Jacopo Garau</Authors>
    <Copyright>Copyright © 2026 Jacopo Garau. All rights reserved.</Copyright>

    <!-- Standalone publish: no dependency on .NET being installed on the user's PC. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET wrapper for the Windows Task Scheduler: more robust and programmatically
         verifiable than shelling out to schtasks.exe (state, last exit code, etc). -->
    <PackageReference Include="TaskScheduler" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded as a resource, so the tray NotifyIcon can load it at runtime at a
         precise size (see TrayApplicationContext.cs), besides being the icon of the
         executable itself (ApplicationIcon above). -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
