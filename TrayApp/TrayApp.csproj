<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>battery.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TrayApp</AssemblyName>
    <RootNamespace>BatteryChargeManager.TrayApp</RootNamespace>

    <!-- Pubblicazione standalone: nessuna dipendenza da .NET installato sul PC dell'utente. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wrapper .NET per il Task Scheduler di Windows: più robusto e verificabile
         programmaticamente rispetto a shellare schtasks.exe (stato, ultimo exit code, ecc). -->
    <PackageReference Include="TaskScheduler" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Incorporata anche come risorsa, così il NotifyIcon in tray può caricarla a runtime
         a una dimensione precisa (vedi TrayApplicationContext.cs), oltre a essere l'icona
         dell'eseguibile stesso (ApplicationIcon sopra). -->
    <EmbeddedResource Include="battery.ico" />
  </ItemGroup>

</Project>
